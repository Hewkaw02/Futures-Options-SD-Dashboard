# ============================================================
# Futures Options SD Dashboard — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your provider credentials.
# See docs/ADAPTERS.md for detailed setup guides.
# ============================================================

# === Active Provider ===
# Options: tastytrade, databento, ibkr, yfinance, deribit
ACTIVE_PROVIDER=tastytrade

# ============================================================
# 1. CME Futures Options (/GC, /ES, /NQ)
# ============================================================

# --- Tastytrade (Default — Brokerage API) ---
# Sign up: https://tastytrade.com/welcome/?referralCode=YGHF9JJZCV
TASTYTRADE_CLIENT_SECRET=your_client_secret_here
TASTYTRADE_REFRESH_TOKEN=your_refresh_token_here

# --- Databento (Recommended — Direct CME Globex Feed) ---
# Sign up: https://databento.com (Includes $125 in free API credits)
# DATABENTO_API_KEY=db-your-key-here

# --- Interactive Brokers (IBKR TWS / Gateway API) ---
# Requires TWS or IB Gateway running locally with Socket API enabled
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1

# ============================================================
# 2. Supplementary Data (Futures Prices & Historical Bars)
# ============================================================

# --- Yahoo Finance (100% Free — No API Key needed) ---
# Provides current & historical prices for /GC (GC=F), /ES (ES=F), /NQ (NQ=F)
# ACTIVE_PROVIDER=yfinance

# ============================================================
# 3. Crypto Options (BTC / ETH)
# ============================================================

# --- Deribit (100% Free Public Market Data — No Key needed) ---
# Top global crypto options exchange with built-in Greeks & Volatility
# ACTIVE_PROVIDER=deribit
